# Copy to .env at the repository root. Never commit .env.
# Generate once; use the same value on frontend and backend.
ARCHITECT_SERVICE_SECRET=replace-with-a-random-secret-at-least-32-characters
ARCHITECT_BACKEND_URL=http://127.0.0.1:8000
# Optional in Phase 1. Empty values enable temporary preview mode.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Reserved for Phase 3; no OpenAI calls are made in Phase 1.
OPENAI_API_KEY=
